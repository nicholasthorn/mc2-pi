FITini
// A repair truck at work, with nothing to shoot it: the two sides are far apart and take no
// orders to attack. Each side's first unit is hit once, then a truck of its own comes and fixes it.
//   scripts/net_smoke.sh --mission mc2_m08 --scenario bench/net_repair.fit --expect-repairs --world-events no --frames 200000

[Bench]
st Mission = "mc2_m08"
l Frames = 200000
l Gather = 12
f LineGap = 4000.0
f Spacing = 90.0
b Pain = TRUE
f ArenaX = 3672.0
f ArenaY = 4497.0
l ReorderEvery = 0
l NetResourcePoints = 1000000
l NetSupportEvery = 200
l NetDamageAt = 100
f NetTimeLimit = 70.0
l NumSegments = 1

[Segment0]
st Name = "repair"
l Start = 0
l NumKeys = 1
f[6] Key0 = 0, 0, 0, 50, 0, 1400
FITend
