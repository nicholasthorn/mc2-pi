FITini
// README media: media/battle.webp, 6 s from the middle of the "clip"
// segment. The first 300 frames let the lines close before recording.
[Bench]
st Mission = "mc2_17"
l Frames = 900
l Gather = 16
f LineGap = 600.0
f Spacing = 90.0
l ReorderEvery = 90
f StrikeRadius = 300.0
b Follow = TRUE
f ScreenX = 0.5
f ScreenY = 0.42
l NumSegments = 2

[Segment0]
st Name = "warmup"
l Start = 0
l NumKeys = 2
f[6] Key0 = 0, 0, 0, 40, 0, 1100
f[6] Key1 = 299, 0, 0, 40, 60, 1100

[Segment1]
st Name = "clip"
l Start = 300
l Shot = 600
l StrikeEvery = 25
l NumKeys = 3
f[6] Key0 = 300, 0, 0, 40, 60, 1100
f[6] Key1 = 600, 0, 0, 40, 120, 1100
f[6] Key2 = 899, 0, 0, 40, 180, 1100

FITend
