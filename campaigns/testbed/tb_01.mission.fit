// ---------------------------------------------------------------- settings and briefing (literal text)

[MissionSettings]
st MissionName = "Testbed: Airfield Raid"
b MissionNameUseResourceString = FALSE
st Author = "testbed"
st Blurb = "Raid the abandoned airfield south of the hills and level the hangar the
bandits use as a depot.

Expect light resistance at the field. Command thinks a relief force is
somewhere to the north."
b BlurbUseResourceString = FALSE
st Blurb2 = "Testbed mission: reach the airfield, destroy the hangar, then deal with whatever comes."
b Blurb2UseResourceString = FALSE
f TimeLimit = -1.000000
f DropWeightLimit = 190.000000
l ResourcePoints = 22000
ul IsSinglePlayer = 1
ul MaximumNumberOfTeams = 2
ul MaximumNumberOfPlayers = 2
uc scenarioTuneNum = 0
st AVIFilename = ""
l AdditionalCBills = 0
ul NumRandomRPbuildings = 0
st DownloadURL = ""
ul MissionType = 0
b AirStrikesEnabledDefault = TRUE
b MineLayersEnabledDefault = TRUE
b ScoutCoptersEnabledDefault = TRUE
b SensorProbesEnabledDefault = TRUE
b UnlimitedAmmoEnabledDefault = TRUE
b AllTechEnabledDefault = TRUE
b RepairVehicleEnabledDefault = TRUE
b SalvageCraftEnabledDefault = TRUE
b ResourceBuildingsEnabledDefault = TRUE
b NoVariantsEnabledDefault = TRUE
b ArtilleryPieceEnabledDefault = TRUE
b RPsForMechsEnabledDefault = TRUE

// ---------------------------------------------------------------- objectives
// 0 reach the airfield -> flag 0 -> 1 destroy the hangar -> flag 1 ->
// 2 destroy the relief lance (tb_01_wave moves when objective 1 succeeds).
// 3 (secondary) destroy the hangar guards.

[Objectives Version]
ul Version = 3

[Team0Objectives]
ul NumObjectives = 4

[Team0Objective0]
st Title = "1. Reach the Airfield"
b TitleUseResourceString = FALSE
st Description = "Move any unit to the abandoned airfield."
