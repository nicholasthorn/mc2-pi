// tb_01: testbed mission, the authored sections only.
// install.sh puts the map's own sections ([Cameras], [Water], [Terrain],
// [ForestN], [Weather], [TheSky]) from the stock mission whose map this is
// (mc2_01) in front of these, and copies mc2_01.pak as tb_01.pak.
//
// Units stand where mc2_01's units stand, so they are on passable ground.
// Objectives find units by start position, so a condition's PositionX/Y must
// match its part exactly.

[Warriors]
ul NumWarriors = 8

[Parts]
ul NumParts = 8

